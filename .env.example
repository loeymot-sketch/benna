# Copie ce fichier en .env (développement) — en production ces valeurs se saisissent dans Vercel > Settings > Environment Variables.
# NE JAMAIS versionner .env.

# --- Base de données : Supabase > Project Settings > Database > Connection string ---
# DATABASE_URL = "Transaction pooler" (port 6543) — utilisée par l'application. Garde les 2 paramètres de fin.
DATABASE_URL="postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = "Session pooler" (port 5432) — utilisée seulement pour créer les tables (npm run db:init).
DIRECT_URL="postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# --- Sessions : 32+ caractères aléatoires.  openssl rand -hex 32 ---
JWT_SECRET=""

# --- Pièces jointes : Supabase > Storage (bucket PRIVÉ nommé "attachments") + Project Settings > API ---
# Vide = stockage sur le disque local (développement).
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="attachments"

# Adresse publique du site (QR de suivi client)
PUBLIC_BASE_URL="https://ton-site.vercel.app"
PORT=8787

# --- Scan IA des pochettes (au moins une clé ; vide = mode démo avec données factices) ---
VISION_PROVIDERS=openrouter,openai,gemini,anthropic
OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
