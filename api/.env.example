# Copie ce fichier en api/.env puis adapte. NE JAMAIS versionner api/.env.
# (start-prod.sh le crée tout seul avec un secret aléatoire s'il n'existe pas.)

# Base SQLite (chemin relatif au dossier api/prisma/)
DATABASE_URL="file:./data/prod.db"

# Secret de signature des sessions : 32+ caractères aléatoires.  openssl rand -hex 32
JWT_SECRET=""

PORT=8787
# Adresse publique du site (QR de suivi client, CORS temps réel)
FRONTEND_ORIGIN="https://labo.example.com"
PUBLIC_BASE_URL="https://labo.example.com"

# --- Scan IA des pochettes (au moins une clé ; vide = mode démo avec données factices) ---
VISION_PROVIDERS=openrouter,openai,gemini,anthropic
OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
